<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VRChatDiscordUploader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:VRChatDiscordUploader.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            
            <!-- ページヘッダー -->
            <StackPanel Spacing="4">
                <TextBlock Text="設定" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Discordの連携設定、メタデータ、画像の最適化、動作環境を設定します" 
                           Style="{StaticResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 保存完了バー / ボタン -->
            <Grid>
                <Button Style="{StaticResource AccentButtonStyle}" 
                        Command="{x:Bind ViewModel.SaveSettingsCommand}" 
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="設定を保存" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 1. Discord 連携設定 -->
            <StackPanel Spacing="8">
                <TextBlock Text="Discord 連携設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        
                        <!-- Webhook URL -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Webhook URL" FontWeight="Medium" />
                            <PasswordBox Password="{x:Bind ViewModel.WebhookUrl, Mode=TwoWay}" 
                                         PlaceholderText="https://discord.com/api/webhooks/..." />
                            <TextBlock Text="※URLはWindows標準の暗号化機能（DPAPI）で安全に保管されます" 
                                       FontSize="11" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- 送信先タイプ -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="送信先の種類" FontWeight="Medium" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.DestinationTypeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="テキストチャンネル" />
                                <ComboBoxItem Content="特定のスレッド（ID指定）" />
                                <ComboBoxItem Content="フォーラムチャンネル（月別スレッド集約）" />
                            </ComboBox>
                        </StackPanel>

                        <!-- スレッドID -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="スレッドID（特定スレッド指定時）" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.ThreadId, Mode=TwoWay}" PlaceholderText="スレッドのチャンネルIDを入力" />
                        </StackPanel>

                        <!-- フォーラムスレッド名形式 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="フォーラム月別スレッドのタイトル形式" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.ForumTitleTemplate, Mode=TwoWay}" PlaceholderText="{}{Year}年{Month}月の写真" />
                            <TextBlock Text="利用可能な変数: {Year}, {Month}, {Date}" 
                                       FontSize="11" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- テスト送信 -->
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Button Command="{x:Bind ViewModel.TestConnectionCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                                    <TextBlock Text="接続テストを送信" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.TestResultText, Mode=OneWay}" 
                                       FontSize="12" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. メタデータ設定 -->
            <StackPanel Spacing="8">
                <TextBlock Text="写真情報・メタデータ設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <ToggleSwitch Header="画像のみ送信（メタデータ・文章を含めない）" 
                                      IsOn="{x:Bind ViewModel.ImageOnly, Mode=TwoWay}" />
                        
                        <StackPanel Spacing="12">
                            <TextBlock Text="含める情報（埋め込み形式）" FontWeight="Medium" />
                            <CheckBox Content="撮影日時" IsChecked="{x:Bind ViewModel.IncludeDateTime, Mode=TwoWay}" />
                            <CheckBox Content="ワールド名" IsChecked="{x:Bind ViewModel.IncludeWorldName, Mode=TwoWay}" />
                            <CheckBox Content="ワールドID / インスタンス情報" IsChecked="{x:Bind ViewModel.IncludeWorldId, Mode=TwoWay}" />
                            <CheckBox Content="同室のプレイヤー一覧" IsChecked="{x:Bind ViewModel.IncludeUsers, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="同室プレイヤーの最大表示人数" FontWeight="Medium" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="1" Maximum="50" Value="{x:Bind ViewModel.MaxUsersCount, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MaxUsersCount, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="上限を超えた人数は「+他○名」と表記されます" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. アップロード・画像最適化設定 -->
            <StackPanel Spacing="8">
                <TextBlock Text="送信・画像最適化設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="連写（連続撮影）時の送信方法" FontWeight="Medium" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.BatchModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="1枚ずつ順次送信（個別送信）" />
                                <ComboBoxItem Content="短時間の連続写真をまとめて送信（最大10枚）" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="まとめ送信の待機時間（秒）" FontWeight="Medium" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="1" Maximum="10" Value="{x:Bind ViewModel.BatchWaitSeconds, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BatchWaitSeconds, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="画像ファイル容量の上限（MB）" FontWeight="Medium" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="4" Maximum="25" StepFrequency="0.5" Value="{x:Bind ViewModel.MaxFileSizeMB, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MaxFileSizeMB, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="※上限を超える場合、PNG形式を維持したまま自動的に解像度を縮小します" 
                                       FontSize="11" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. システム・通知設定 -->
            <StackPanel Spacing="8">
                <TextBlock Text="システム・通知設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Windows通知レベル" FontWeight="Medium" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.NotificationLevelIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="エラー時のみ通知（推奨）" />
                                <ComboBoxItem Content="すべて通知（送信完了時も通知）" />
                                <ComboBoxItem Content="通知しない" />
                            </ComboBox>
                        </StackPanel>

                        <ToggleSwitch Header="Windows起動時に自動起動する" 
                                      IsOn="{x:Bind ViewModel.AutoStartWithWindows, Mode=TwoWay}" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="カスタム写真保存フォルダ（未指定時はVRChat標準フォルダ）" FontWeight="Medium" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.CustomWatchDirectory, Mode=TwoWay}" 
                                         PlaceholderText="標準フォルダを使用する場合は空欄" />
                                <Button Grid.Column="1" Click="BrowseFolderButton_Click">
                                    <TextBlock Text="参照..." />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
