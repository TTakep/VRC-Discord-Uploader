<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VRChatDiscordUploader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:VRChatDiscordUploader.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,36">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                
                <!-- ページヘッダー -->
                <StackPanel Spacing="4">
                    <TextBlock Text="設定" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Discordの連携設定、メタデータ、画像の最適化、動作環境を設定します" 
                               Style="{StaticResource BodyTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 保存ボタン＆保存完了通知（左揃えで配置） -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" 
                            Command="{x:Bind ViewModel.SaveSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="設定を保存" />
                        </StackPanel>
                    </Button>

                    <InfoBar IsOpen="{x:Bind ViewModel.IsSavedMessageOpen, Mode=TwoWay}"
                             Severity="Success"
                             Message="{x:Bind ViewModel.SavedMessageText, Mode=OneWay}"
                             IsClosable="True" />
                </StackPanel>

                <!-- 1. Discord 連携設定 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Discord 連携設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            
                            <!-- Webhook URL -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Webhook URL" FontWeight="Medium" />
                                <PasswordBox Password="{x:Bind ViewModel.WebhookUrl, Mode=TwoWay}" 
                                             PlaceholderText="https://discord.com/api/webhooks/..." 
                                             HorizontalAlignment="Stretch" />
                                <TextBlock Text="※URLはWindows標準の暗号化機能（DPAPI）で安全に保管されます" 
                                           FontSize="11" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 送信先タイプ -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="送信先の種類" FontWeight="Medium" />
                                <ComboBox SelectedIndex="{x:Bind ViewModel.DestinationTypeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="テキストチャンネル" />
                                    <ComboBoxItem Content="特定のスレッド（ID指定）" />
                                    <ComboBoxItem Content="フォーラムチャンネル（月別スレッド集約）" />
                                </ComboBox>
                            </StackPanel>

                            <!-- スレッドID -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="スレッドID（特定スレッド指定時）" FontWeight="Medium" />
                                <TextBox Text="{x:Bind ViewModel.ThreadId, Mode=TwoWay}" 
                                         PlaceholderText="スレッドのチャンネルIDを入力" 
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- フォーラムスレッド名形式 -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="フォーラム月別スレッドのタイトル形式" FontWeight="Medium" />
                                <TextBox Text="{x:Bind ViewModel.ForumTitleTemplate, Mode=TwoWay}" 
                                         PlaceholderText="{}{Year}年{Month}月の写真" 
                                         HorizontalAlignment="Stretch" />
                                <TextBlock Text="利用可能な変数: {Year}, {Month}, {Date}" 
                                           FontSize="11" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- テスト送信 -->
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <Button Command="{x:Bind ViewModel.TestConnectionCommand}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE724;" FontSize="14" />
                                        <TextBlock Text="接続テストを送信" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.TestResultText, Mode=OneWay}" 
                                           FontSize="12" 
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. メタデータ設定 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="写真情報・メタデータ設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <ToggleSwitch Header="画像のみ送信（メタデータ・文章を含めない）" 
                                          IsOn="{x:Bind ViewModel.ImageOnly, Mode=TwoWay}" />
                            
                            <StackPanel Spacing="12">
                                <TextBlock Text="含める情報（埋め込み形式）" FontWeight="Medium" />
                                <CheckBox Content="撮影日時" IsChecked="{x:Bind ViewModel.IncludeDateTime, Mode=TwoWay}" />
                                <CheckBox Content="ワールド名" IsChecked="{x:Bind ViewModel.IncludeWorldName, Mode=TwoWay}" />
                                <CheckBox Content="ワールドID / インスタンス情報" IsChecked="{x:Bind ViewModel.IncludeWorldId, Mode=TwoWay}" />
                                <CheckBox Content="同室のプレイヤー一覧" IsChecked="{x:Bind ViewModel.IncludeUsers, Mode=TwoWay}" />
                                <CheckBox Content="写真の解像度・容量（最適化情報）を含める" IsChecked="{x:Bind ViewModel.IncludeResolutionAndSize, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="同室プレイヤーの最大表示人数" FontWeight="Medium" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="50" Value="{x:Bind ViewModel.MaxUsersCount, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MaxUsersCount, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock Text="上限を超えた人数は「+他○名」と表記されます" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. アップロード・画像最適化設定 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="送信・画像最適化設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="連写（連続撮影）時の送信方法" FontWeight="Medium" />
                                <ComboBox SelectedIndex="{x:Bind ViewModel.BatchModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="1枚ずつ順次送信（個別送信）" />
                                    <ComboBoxItem Content="短時間の連続写真をまとめて送信（最大10枚）" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="まとめ送信の待機時間（秒）" FontWeight="Medium" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="10" Value="{x:Bind ViewModel.BatchWaitSeconds, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BatchWaitSeconds, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="自動リサイズの基準ファイル容量（MB）" FontWeight="Medium" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="25" Value="{x:Bind ViewModel.MaxFileSizeMB, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.MaxFileSizeMB, Mode=OneWay}" FontWeight="SemiBold" />
                                        <TextBlock Text="MB" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Discordのファイル上限（通常8MB、Nitroで25MB等）に合わせて自動でPNGのまま縮小します" 
                                           FontSize="11" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. システム・動作環境設定 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="システム・動作環境" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="写真保存フォルダー（未指定時はVRChatの標準フォルダー）" FontWeight="Medium" />
                                <TextBox Text="{x:Bind ViewModel.CustomWatchDirectory, Mode=TwoWay}" 
                                         PlaceholderText="C:\Users\...\Pictures\VRChat" 
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="通知設定" FontWeight="Medium" />
                                <ComboBox SelectedIndex="{x:Bind ViewModel.NotificationLevelIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="エラー発生時のみ通知" />
                                    <ComboBoxItem Content="すべての送信結果を通知" />
                                    <ComboBoxItem Content="通知しない" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="ウィンドウを閉じたときの動作" FontWeight="Medium" />
                                <ComboBox SelectedIndex="{x:Bind ViewModel.CloseBehaviorIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="タスクトレイに最小化（バックグラウンドで監視継続）" />
                                    <ComboBoxItem Content="アプリケーションを完全に終了" />
                                </ComboBox>
                                <TextBlock Text="タスクトレイに最小化した場合は、通知領域のアイコンからいつでも再表示できます" 
                                           FontSize="11" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ToggleSwitch Header="Windows起動時に自動実行する" 
                                          IsOn="{x:Bind ViewModel.AutoStartWithWindows, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                
            </StackPanel>
    </ScrollViewer>
</Page>
